# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/gowtham_tex

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Configuration (Optional: specify comma-separated allowed origins or leave blank)
CORS_ORIGIN=http://localhost:5173

# Admin Initial Seed Credentials (Optional)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@gowthamtex.com
ADMIN_PASSWORD=admin_secure_password
ADMIN_PHONE=+919842712345

# SMS Gateway Configuration (Optional)
SMS_API_KEY=your_sms_api_key_here
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
